export type PartRole = "drums" | "bass" | "keys" | "melody" | "pad";
export type ScoreNote = { id: string; midi: number; start: number; duration: number; velocity: number };
export type ScorePart = { id: string; name: string; role: PartRole; source: "human" | "copilot"; kept: boolean; muted?: boolean; volume: number; notes: ScoreNote[] };
export type ScoreSection = { id: string; name: string; startBar: number; bars: number };
export type Score = { version: 1; key: string; bars: number; beatsPerBar: number; sections: ScoreSection[]; chords: string[]; parts: ScorePart[] };

export const SCORE_LIMITS: Readonly<{ maxBars: number; maxParts: number; maxNotesPerPart: number; minMidi: number; maxMidi: number }>;
export const PART_ROLES: readonly PartRole[];
export const DRUM_NOTES: Readonly<{ kick: number; snare: number; hat: number }>;
export function hashSeed(text: string): number;
export function makeId(prefix: string): string;
export function parseKey(key: string): { tonic: string; mode: "major" | "minor" };
export function diatonicChords(key: string): string[];
export function scaleChromas(key: string): number[];
export function chordChromas(symbol: string): number[];
export function midiToName(midi: number): string;
export function createDefaultScore(options?: { key?: string; bars?: number }): Score;
export function sanitizeScore(input: unknown): Score | null;
export function readPromptOptions(prompt?: string): { density: number; halfTime: boolean; lift: boolean };
export function draftParts(score: Score, options?: { roles?: PartRole[]; sectionId?: string; prompt?: string; seed?: number }): Score;
export function keepPart(score: Score, partId: string): Score;
export function discardPart(score: Score, partId: string): Score;
export function updatePart(score: Score, partId: string, patch: Partial<ScorePart>): Score;
export function setChord(score: Score, bar: number, symbol: string): Score;
export function setKey(score: Score, key: string): Score;
export function scoreToMidi(score: Score, options?: { bpm?: number; title?: string }): Uint8Array;
export function beatsToSeconds(beats: number, bpm: number): number;
