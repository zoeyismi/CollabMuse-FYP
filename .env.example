# Optional: enables OpenAI-backed Music Copilot generation.
# Without this key, CollabMuse uses its built-in local composer fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Required for real prompt-to-music audio generation in Music Copilot.
# ElevenLabs Music API is a paid feature. Keep this key on the server only.
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_MODEL=music_v2_5
